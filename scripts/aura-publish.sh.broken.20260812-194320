#!/usr/bin/env bash

set -u

REMOTE="origin"
MAX_SIZE=$((100 * 1024 * 1024))
DEFAULT_MESSAGE="chore: synchronize AURA project state"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [ -z "$REPO_ROOT" ]; then
    echo "❌ Este diretório não é um repositório Git."
    exit 1
fi

cd "$REPO_ROOT" || exit 1


# ============================================================
# UTILITÁRIOS
# ============================================================

current_branch() {
    git branch --show-current
}

pause() {
    echo
    read -r -p "Pressione ENTER para continuar..." _
}

header() {
    clear 2>/dev/null || true

    echo "=============================================="
    echo "          AURA GitHub Manager"
    echo "=============================================="
    echo "Repositório: $(basename "$REPO_ROOT")"
    echo "Branch:      $(current_branch)"
    echo "Remoto:      $REMOTE"
    echo "=============================================="
    echo
}

remote_exists() {
    git remote get-url "$REMOTE" >/dev/null 2>&1
}

has_worktree_changes() {
    ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git status --porcelain)" ]
}


# ============================================================
# BRANCHES
# ============================================================

list_branches() {
    git fetch "$REMOTE" --prune >/dev/null 2>&1 || true

    echo "=== BRANCHES LOCAIS ==="
    git for-each-ref \
        --format='%(refname:short)' \
        refs/heads/ |
        sort

    echo
    echo "=== BRANCHES DO GITHUB ==="

    git for-each-ref \
        --format='%(refname:short)' \
        refs/remotes/"$REMOTE"/ |
        sed "s#^$REMOTE/##" |
        grep -v '^HEAD$' |
        sort
}

select_branch() {
    header

    if has_worktree_changes; then
        echo "❌ Existem alterações locais."
        echo
        git status --short
        echo
        echo "Primeiro faça commit ou preserve suas alterações."
        echo "A troca de branch foi cancelada."
        pause
        return 1
    fi

    git fetch "$REMOTE" --prune || {
        echo "❌ Não foi possível atualizar as branches do GitHub."
        pause
        return 1
    }

    mapfile -t BRANCHES < <(
        git for-each-ref \
            --format='%(refname:short)' \
            refs/remotes/"$REMOTE"/ |
        sed "s#^$REMOTE/##" |
        grep -v '^HEAD$' |
        sort -u
    )

    if [ "${#BRANCHES[@]}" -eq 0 ]; then
        echo "❌ Nenhuma branch remota encontrada."
        pause
        return 1
    fi

    echo "=== BRANCHES DO GITHUB ==="
    echo

    local i=1
    local CURRENT
    CURRENT="$(current_branch)"

    for branch in "${BRANCHES[@]}"; do
        if [ "$branch" = "$CURRENT" ]; then
            echo "$i) $branch [ATUAL]"
        else
            echo "$i) $branch"
        fi
        ((i++))
    done

    echo
    echo "$i) Criar/usar branch pelo nome"
    echo "0) Cancelar"
    echo

    local choice
    read -r -p "Escolha: " choice

    if [ "$choice" = "0" ]; then
        return 0
    fi

    local selected=""

    if [ "$choice" = "$i" ]; then
        read -r -p "Nome da branch: " selected
    elif [[ "$choice" =~ ^[0-9]+$ ]] &&
         [ "$choice" -ge 1 ] &&
         [ "$choice" -le "${#BRANCHES[@]}" ]; then

        selected="${BRANCHES[$((choice-1))]}"
    else
        echo "❌ Opção inválida."
        pause
        return 1
    fi

    if [ -z "$selected" ]; then
        echo "❌ Nome de branch vazio."
        pause
        return 1
    fi

    echo
    echo "Branch selecionada: $selected"

    if git show-ref --verify --quiet "refs/heads/$selected"; then

        git checkout "$selected" || {
            echo "❌ Não foi possível trocar para $selected."
            pause
            return 1
        }

    elif git show-ref --verify --quiet "refs/remotes/$REMOTE/$selected"; then

        git checkout -b "$selected" "$REMOTE/$selected" || {
            echo "❌ Não foi possível criar a branch local."
            pause
            return 1
        }

    else

        echo
        read -r -p "Branch não existe. Criar localmente? [s/N]: " answer

        if [[ "$answer" =~ ^[sS]$ ]]; then
            git checkout -b "$selected" || {
                echo "❌ Falha ao criar branch."
                pause
                return 1
            }
        else
            echo "Operação cancelada."
            pause
            return 0
        fi
    fi

    echo
    echo "✅ Branch atual: $(current_branch)"
    pause
}


# ============================================================
# STATUS
# ============================================================

show_status() {
    header

    echo "=== STATUS ==="
    git status

    echo
    echo "=== REMOTO ==="
    git remote -v

    echo
    echo "=== SINCRONIZAÇÃO ==="

    local branch
    branch="$(current_branch)"

    git fetch "$REMOTE" --prune >/dev/null 2>&1 || true

    if git rev-parse --verify "$REMOTE/$branch" >/dev/null 2>&1; then

        local ahead
        local behind

        ahead="$(git rev-list --count "$REMOTE/$branch..HEAD")"
        behind="$(git rev-list --count "HEAD..$REMOTE/$branch")"

        echo "À frente: $ahead commit(s)"
        echo "Atrás:    $behind commit(s)"

        if [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ]; then
            echo "✅ Local e GitHub sincronizados."
        elif [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
            echo "⚠️ Branch divergente."
            echo "Não será feito merge automático."
        fi
    else
        echo "ℹ️ Branch ainda não possui referência remota."
    fi

    echo
    echo "=== ÚLTIMOS COMMITS ==="
    git log --oneline --decorate -8

    pause
}


# ============================================================
# COMMITS
# ============================================================

show_commits() {
    header

    echo "=== ÚLTIMOS 30 COMMITS ==="
    git log --oneline --decorate --graph -30

    pause
}


# ============================================================
# ARQUIVOS GRANDES
# ============================================================

check_large_files() {
    header

    echo "=== ARQUIVOS RASTREADOS ACIMA DE 100 MB ==="
    echo

    found=0

    while IFS= read -r file; do
        [ -f "$file" ] || continue

        size="$(wc -c < "$file")"

        if [ "$size" -gt "$MAX_SIZE" ]; then
            mb=$((size / 1024 / 1024))

            echo "❌ ${mb} MB  $file"

            found=1
        fi

    done < <(git ls-files)

    if [ "$found" -eq 0 ]; then
        echo "✅ Nenhum arquivo rastreado ultrapassa 100 MB."
    fi

    echo
    echo "=== ARQUIVOS GRANDES NO DIRETÓRIO ==="

    find . \
        -type f \
        -size +100M \
        -not -path './.git/*' \
        -print 2>/dev/null |
        while IFS= read -r file; do
            size="$(wc -c < "$file")"
            mb=$((size / 1024 / 1024))
            echo "⚠️  ${mb} MB  $file"
        done

    pause
}


# ============================================================
# APKs
# ============================================================

protect_apks() {
    echo "=== PROTEÇÃO DOS APKs ==="

    if ! grep -qxF '/aura-mobile-apk-debug/*.apk' .gitignore 2>/dev/null; then

        printf '\n# APKs gerados localmente\n/aura-mobile-apk-debug/*.apk\n' >> .gitignore

        echo "✅ APKs adicionados ao .gitignore."

    else

        echo "✅ APKs já estão protegidos pelo .gitignore."

    fi

    echo
    echo "=== APKs RASTREADOS PELO GIT ==="

    mapfile -t APK_FILES < <(
        git ls-files 'aura-mobile-apk-debug/*.apk'
    )

    if [ "${#APK_FILES[@]}" -eq 0 ]; then

        echo "✅ Nenhum APK está sendo rastreado."

    else

        for file in "${APK_FILES[@]}"; do
            echo "⚠️ $file"
        done

        echo
        echo "Esses APKs precisam sair do índice do Git."

        read -r -p "Remover do Git sem apagar os arquivos locais? [s/N]: " answer

        if [[ "$answer" =~ ^[sS]$ ]]; then

            git rm --cached -- "${APK_FILES[@]}" || {
                echo "❌ Falha ao remover APKs do índice."
                return 1
            }

            echo
            echo "✅ APKs removidos do Git."
            echo "✅ Arquivos locais preservados."

        else

            echo "Operação cancelada."
        fi
    }
}


# ============================================================
# ATUALIZAÇÃO DO GITHUB
# ============================================================

update_remote() {
    header

    echo "=== ATUALIZANDO GITHUB ==="

    if ! remote_exists; then
        echo "❌ Remoto '$REMOTE' não existe."
        pause
        return 1
    fi

    if ! git fetch "$REMOTE" --prune; then
        echo "❌ Falha ao buscar informações do GitHub."
        pause
        return 1
    fi

    echo
    echo "✅ Referências do GitHub atualizadas."

    pause
}


# ============================================================
# SINCRONIZAÇÃO SEM MERGE AUTOMÁTICO
# ============================================================

sync_branch() {
    local branch
    branch="$(current_branch)"

    git fetch "$REMOTE" --prune || return 1

    if ! git rev-parse --verify "$REMOTE/$branch" >/dev/null 2>&1; then
        echo "ℹ️ Branch ainda não existe no GitHub."
        return 0
    fi

    local ahead
    local behind

    ahead="$(git rev-list --count "$REMOTE/$branch..HEAD")"
    behind="$(git rev-list --count "HEAD..$REMOTE/$branch")"

    echo
    echo "À frente: $ahead"
    echo "Atrás:    $behind"

    if [ "$behind" -eq 0 ]; then
        echo "✅ Nenhuma atualização remota necessária."
        return 0
    fi

    if [ "$ahead" -gt 0 ]; then
        echo
        echo "⚠️ Branch divergente."
        echo
        echo "Local possui commits próprios e o GitHub também possui commits."
        echo "Nenhum merge automático será feito."
        echo
        echo "Resolva a divergência manualmente."
        return 1
    fi

    echo
    echo "=== ATUALIZANDO BRANCH ==="

    git pull --ff-only "$REMOTE" "$branch" || {
        echo "❌ Fast-forward não foi possível."
        echo "Nenhum merge automático foi criado."
        return 1
    }

    echo "✅ Branch atualizada."
}


# ============================================================
# VERIFICAÇÃO DO ÍNDICE
# ============================================================

check_staged_large_files() {
    local found=0

    while IFS= read -r file; do

        [ -f "$file" ] || continue

        local size
        size="$(wc -c < "$file")"

        if [ "$size" -gt "$MAX_SIZE" ]; then

            local mb
            mb=$((size / 1024 / 1024))

            echo "❌ Arquivo acima de 100 MB:"
            echo "   ${mb} MB  $file"

            found=1
        fi

    done < <(git diff --cached --name-only --diff-filter=ACMR)

    return "$found"
}


# ============================================================
# COMMIT + PUSH
# ============================================================

commit_and_push() {
    header

    local branch
    branch="$(current_branch)"

    echo "=== PREPARAÇÃO ==="
    echo

    protect_apks

    echo
    echo "=== STATUS ==="
    git status --short

    echo

    if ! has_worktree_changes; then
        echo "ℹ️ Nenhuma alteração para publicar."
        pause
        return 0
    fi

    echo "=== ADICIONANDO ALTERAÇÕES ==="

    git add -A || {
        echo "❌ git add falhou."
        pause
        return 1
    }

    echo
    echo "=== VERIFICANDO ARQUIVOS ACIMA DE 100 MB ==="

    if check_staged_large_files; then

        echo
        echo "❌ PUSH/COMMIT CANCELADO."
        echo "Foi encontrado arquivo acima de 100 MB no índice."
        echo
        echo "As alterações continuam no diretório de trabalho."
        echo "Nenhum force push será executado."

        git reset >/dev/null 2>&1 || true

        pause
        return 1
    fi

    if git diff --cached --quiet; then
        echo "ℹ️ Nenhuma alteração para commit."
        pause
        return 0
    fi

    echo
    echo "=== ALTERAÇÕES QUE SERÃO COMMITADAS ==="
    git diff --cached --stat

    echo
    read -r -p "Mensagem do commit [$DEFAULT_MESSAGE]: " MESSAGE

    if [ -z "$MESSAGE" ]; then
        MESSAGE="$DEFAULT_MESSAGE"
    fi

    echo
    echo "=== CRIANDO COMMIT ==="

    if ! git commit -m "$MESSAGE"; then
        echo "❌ Commit falhou."
        pause
        return 1
    fi

    echo
    echo "=== VERIFICANDO BRANCH REMOTA ==="

    git fetch "$REMOTE" --prune || {
        echo "❌ Não foi possível atualizar o remoto."
        echo "O commit local foi preservado."
        pause
        return 1
    }

    echo
    echo "=== PUSH PARA $branch ==="

    if git push "$REMOTE" "$branch"; then

        echo
        echo "=============================================="
        echo "✅ PUSH CONCLUÍDO"
        echo "=============================================="
        echo "Branch: $branch"
        echo "Commit:"
        git log -1 --oneline

    else

        echo
        echo "=============================================="
        echo "❌ PUSH RECUSADO"
        echo "=============================================="

        echo
        echo "O commit LOCAL foi preservado."
        echo "Nenhum force push será executado."

        echo
        echo "Verificando estado:"

        git status

        echo
        echo "Possíveis causas:"
        echo "• proteção da branch"
        echo "• arquivo grande"
        echo "• autenticação/permissão"
        echo "• branch divergente"
        echo "• regra do GitHub"
    fi

    pause
}


# ============================================================
# SINCRONIZAÇÃO COMPLETA
# ============================================================

full_sync() {
    header

    echo "=== SINCRONIZAÇÃO COMPLETA ==="
    echo

    if has_worktree_changes; then

        echo "⚠️ Existem alterações locais:"
        git status --short

        echo
        echo "A sincronização automática não vai mexer nelas."

        read -r -p "Continuar apenas atualizando referências do GitHub? [s/N]: " answer

        if ! [[ "$answer" =~ ^[sS]$ ]]; then
            echo "Operação cancelada."
            pause
            return 0
        fi
    fi

    if ! git fetch "$REMOTE" --prune; then
        echo "❌ Falha no fetch."
        pause
        return 1
    fi

    echo
    sync_branch

    echo
    echo "=== PROTEÇÃO DOS APKs ==="

    protect_apks

    echo
    echo "=== ESTADO FINAL ==="

    git status --short

    echo
    echo "=============================================="
    echo "Sincronização analisada."
    echo "=============================================="

    pause
}


# ============================================================
# MENU
# ============================================================

menu() {

    while true; do

        header

        echo "1) Selecionar Branch"
        echo "2) Status"
        echo "3) Atualizar do GitHub"
        echo "4) Commit e Push"
        echo "5) Ver commits"
        echo "6) Ver arquivos grandes"
        echo "7) Proteger APKs / .gitignore"
        echo "8) Sincronização completa"
        echo "9) Ver branches"
        echo "0) Sair"

        echo

        read -r -p "Escolha: " OPTION

        case "$OPTION" in

            1)
                select_branch
                ;;

            2)
                show_status
                ;;

            3)
                update_remote
                ;;

            4)
                commit_and_push
                ;;

            5)
                show_commits
                ;;

            6)
                check_large_files
                ;;

            7)
                header
                protect_apks
                echo
                git status --short
                pause
                ;;

            8)
                full_sync
                ;;

            9)
                header
                list_branches
                pause
                ;;

            0)
                echo
                echo "AURA GitHub Manager encerrado."
                exit 0
                ;;

            *)
                echo
                echo "❌ Opção inválida."
                sleep 1
                ;;

        esac

    done
}


# ============================================================
# INÍCIO
# ============================================================

menu
