  "problemas_conhecidos": [
    {
      "id": "PROCESS_START_TERMUX",
      "descricao": "System.Diagnostics.Process.Start com UseShellExecute=false (redirect stdout/stderr) trava no Termux",
      "causa": "Termux não suporta pipe de I/O em processos filhos via Process.Start do .NET. at+e bash -c também trava com redirect.",
      "impacto": "Todos os testes que usam ShellExecutor, GitExecutor, PythonExecutor, NodeExecutor ou SimulationRuntime falham/travam no Termux.",
      "tentativas_de_fix": [
        "Usar UseShellExecute=false com BeginOutputReadLine + WaitForExitAsync -> trava",
        "Usar UseShellExecute=false com ReadToEnd síncrono -> trava",
        "Usar UseShellExecute=true sem redirect -> não captura output",
        "Fallback via bash -c -> trava igual"
      ],
      "status": "SEM_SOLUCAO_CONHECIDA",
      "workaround": "Rodar testes que usam Process.Start apenas no GitHub Actions (Linux real). NO Termux rodar apenas testes CAN (puros .NET sem processo externo).",
      "solucao_possivel_futura": {
        "usar_bash_com_arquivos_temporarios": "Usar UseShellExecute=true e redirecionar stdout/stderr para arquivos temporários, depois ler os arquivos. Evita pipe de I/O.",
        "usar_termux_api": "Usar termux-exec (LD_LIBRARY_PATH nativo) ou API do Termux via termux-api-package."
      }
    },
    {
      "id": "GIT_PYTHON_SHARED_LIB",
      "descricao": "/usr/bin/git e /usr/bin/python3 no Termux falham com 'error while loading shared libraries: libc.so: No such file or directory'",
      "causa": "LD_LIBRARY_PATH do Termux não é herdado por Process.Start com UseShellExecute=false.",
      "status": "SEM_SOLUCAO_CONHECIDA (mesmo root cause do PROCESS_START_TERMUX)",
      "workaround": "Idem acima - rodar apenas em GitHub Actions."
    }
  ],
