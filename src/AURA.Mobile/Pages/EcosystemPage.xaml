<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.EcosystemPage"
             Title="Ecossistema AURA"
             BackgroundColor="{DynamicResource AuraBackground}">
    
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        
        <Label Text="🌌 Ecossistema AURA"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="{DynamicResource AuraTextPrimary}" />
        
        <CollectionView Grid.Row="1" 
                        x:Name="ModulesCollection"
                        ItemsSource="{Binding Modules}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" 
                          BackgroundColor="{DynamicResource AuraSurface}"
                          CornerRadius="8"
                          Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Grid.Column="0" 
                               Text="{Binding Icon}"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        
                        <VerticalStackLayout Grid.Column="1" 
                                             Margin="10,0,0,0">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AuraTextPrimary}"/>
                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="{DynamicResource AuraTextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </Grid>
</ContentPage>
