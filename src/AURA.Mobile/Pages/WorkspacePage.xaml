<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pdf="clr-namespace:MauiNativePdfView;assembly=MauiNativePdfView"
             x:Class="AURA.Mobile.Pages.WorkspacePage"
             Title="Workspace"
             BackgroundColor="{DynamicResource AuraBackground}">
    <Grid Padding="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

        <!-- Ações locais (sem IA) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Importar" Clicked="OnImportClicked" />
            <Button Text="Atualizar" Clicked="OnRefreshClicked" />
            <Label x:Name="StatusLabel" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </HorizontalStackLayout>

        <Picker x:Name="DocumentPicker" Grid.Row="1" Title="Documento do Workspace" SelectedIndexChanged="OnDocumentSelected" />

        <!-- Documento aberto -->
        <Grid Grid.Row="2">
            <Grid x:Name="WordEditor" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8">
                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Label Text="Word (.docx)" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Text="Salvar" Clicked="OnSaveWordClicked" />
                </HorizontalStackLayout>
                <Editor Grid.Row="1" x:Name="WordTextEditor" AutoSize="TextChanges" VerticalOptions="Fill" />
            </Grid>

            <Grid x:Name="PdfEditor" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8">
                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Label x:Name="PdfInfoLabel" Text="PDF" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Text="Girar" Clicked="OnRotatePdfClicked" />
                    <Button Text="Adicionar página" Clicked="OnAddPdfPageClicked" />
                    <Button Text="Excluir página" Clicked="OnDeletePdfPageClicked" />
                </HorizontalStackLayout>
                <pdf:PdfView Grid.Row="1" x:Name="PdfViewer"
                             EnableZoom="True"
                             EnableSwipe="True"
                             EnableLinkNavigation="True"
                             EnableAnnotationRendering="True"
                             BackgroundColor="Transparent" />
            </Grid>

            <Label x:Name="EmptyHint"
                   Text="Importe ou selecione um documento. Ações locais não usam IA."
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Opacity="0.7" />
        </Grid>

        <!-- Pedido ao agente (IA opcional, com contexto do arquivo) -->
        <Border Grid.Row="3"
                StrokeThickness="1"
                Padding="10"
                Stroke="{DynamicResource AuraSurface2}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <Label Text="O que você quer fazer com este arquivo?"
                       FontAttributes="Bold" />

                <HorizontalStackLayout Grid.Row="1" Spacing="6">
                    <Button Text="Resumir" FontSize="12" Padding="10,4" Clicked="OnChipResumir" />
                    <Button Text="Corrigir" FontSize="12" Padding="10,4" Clicked="OnChipCorrigir" />
                    <Button Text="Simplificar" FontSize="12" Padding="10,4" Clicked="OnChipSimplificar" />
                    <Button Text="Explicar" FontSize="12" Padding="10,4" Clicked="OnChipExplicar" />
                </HorizontalStackLayout>

                <Editor Grid.Row="2"
                        x:Name="IntentEditor"
                        Placeholder="Escreva livremente, ex.: tire as partes repetidas e deixe mais curto"
                        AutoSize="TextChanges"
                        HeightRequest="72" />

                <HorizontalStackLayout Grid.Row="3" Spacing="8">
                    <Button x:Name="SendAgentButton"
                            Text="Enviar ao agente"
                            Clicked="OnSendToAgentClicked" />
                    <Button x:Name="ApplyWordButton"
                            Text="Aplicar no Word"
                            IsVisible="False"
                            Clicked="OnApplyAgentToWordClicked" />
                </HorizontalStackLayout>

                <Editor Grid.Row="4"
                        x:Name="AgentResponseEditor"
                        Placeholder="Resposta do agente aparece aqui"
                        IsReadOnly="True"
                        AutoSize="TextChanges"
                        HeightRequest="100" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
