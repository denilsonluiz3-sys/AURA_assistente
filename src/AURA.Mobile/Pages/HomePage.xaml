<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource AuraBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <!-- ── Header ─────────────────────────────── -->
            <VerticalStackLayout Spacing="2">
                <Label Text="A U R A"
                       FontSize="32"
                       FontAttributes="Bold"
                       LetterSpacing="6"
                       TextColor="{DynamicResource AuraAccent}" />
                <Label x:Name="VersionLabel"
                       FontSize="12"
                       LetterSpacing="1"
                       TextColor="{DynamicResource AuraTextSecondary}" />
            </VerticalStackLayout>

            <!-- ── Card Sistema ───────────────────────── -->
            <Border Style="{StaticResource AuraCardAccent}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="⚙"
                               FontSize="16"
                               TextColor="{DynamicResource AuraAccent}" />
                        <Label Text="SISTEMA"
                               FontSize="11"
                               LetterSpacing="2"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AuraAccent}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{DynamicResource AuraBorder}"
                             Margin="0,0,0,2" />
                    <Label x:Name="OsLabel"   FontSize="13" TextColor="{DynamicResource AuraTextPrimary}" />
                    <Label x:Name="CpuLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="RamLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="DiskLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Card Rede ──────────────────────────── -->
            <Border Style="{StaticResource AuraCard}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="⊕"
                               FontSize="16"
                               TextColor="{DynamicResource AuraCyan}" />
                        <Label Text="REDE"
                               FontSize="11"
                               LetterSpacing="2"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AuraCyan}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{DynamicResource AuraBorder}"
                             Margin="0,0,0,2" />
                    <Label x:Name="NetLabel" FontSize="13" TextColor="{DynamicResource AuraTextPrimary}" />
                    <Label x:Name="IpLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Card Agentes ──────────────────────── -->
            <Border Style="{StaticResource AuraCard}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="◆"
                               FontSize="16"
                               TextColor="{DynamicResource AuraSuccess}" />
                        <Label Text="AGENTES DISPONÍVEIS"
                               FontSize="11"
                               LetterSpacing="2"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AuraSuccess}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{DynamicResource AuraBorder}"
                             Margin="0,0,0,2" />
                    <Label x:Name="AgentsLabel"
                           FontSize="13"
                           TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Botão Atualizar ───────────────────── -->
            <Button Text="↻  Atualizar"
                    Clicked="OnRefreshClicked"
                    Style="{StaticResource BtnGhost}"
                    HorizontalOptions="Start" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
