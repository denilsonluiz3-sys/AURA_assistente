<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource AuraBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="AURA"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AuraTextPrimary}" />

            <Label x:Name="VersionLabel"
                   FontSize="14"
                   TextColor="{DynamicResource AuraTextSecondary}" />

            <Frame BackgroundColor="{DynamicResource AuraSurface}"
                   BorderColor="Transparent"
                   CornerRadius="12"
                   Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sistema"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{DynamicResource AuraTextPrimary}" />
                    <Label x:Name="OsLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="CpuLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="RamLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="DiskLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{DynamicResource AuraSurface}"
                   BorderColor="Transparent"
                   CornerRadius="12"
                   Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rede"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{DynamicResource AuraTextPrimary}" />
                    <Label x:Name="NetLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                    <Label x:Name="IpLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{DynamicResource AuraSurface}"
                   BorderColor="Transparent"
                   CornerRadius="12"
                   Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Assistentes disponíveis (agentes)"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{DynamicResource AuraTextPrimary}" />
                    <Label x:Name="AgentsLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Atualizar"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="{DynamicResource AuraAccent}"
                    TextColor="White"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
