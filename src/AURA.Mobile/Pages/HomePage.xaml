<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- ── Header glass ─────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="#2e0d0f18"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                Padding="20,16"
                StrokeShape="RoundRectangle 0,0,24,24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="A U R A"
                           Style="{StaticResource Heading}"
                           TextColor="{DynamicResource AuraAccent}"
                           FontSize="32" />
                    <Label x:Name="VersionLabel"
                           FontSize="12"
                           TextColor="{DynamicResource AuraTextMuted}"
                           FontFamily="IBMPlexSans" />
                </VerticalStackLayout>

                <!-- Botão de tema Solar/Lunar -->
                <Border Grid.Column="1"
                        x:Name="ThemeButton"
                        BackgroundColor="#2e0d0f18"
                        Stroke="{DynamicResource AuraBorderAccent}"
                        StrokeThickness="1"
                        WidthRequest="48" HeightRequest="48"
                        StrokeShape="RoundRectangle 24,24,24,24">
                    <Label x:Name="ThemeIcon"
                           Text="🌙"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThemeToggled" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- ── Conteúdo principal ─────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,20" Spacing="16">

                <!-- Orb central -->
                <Grid HeightRequest="200" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="OuterRing"
                            Stroke="{DynamicResource AuraAccent}"
                            StrokeThickness="1.5"
                            BackgroundColor="Transparent"
                            WidthRequest="200" HeightRequest="200"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100" />
                        </Border.StrokeShape>
                    </Border>
                    <Border x:Name="MiddleRing"
                            Stroke="{DynamicResource AuraCyan}"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            WidthRequest="150" HeightRequest="150"
                            Opacity="0.7"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="75" />
                        </Border.StrokeShape>
                    </Border>
                    <Border x:Name="CoreOrb"
                            BackgroundColor="{DynamicResource AuraAccentDim}"
                            WidthRequest="90" HeightRequest="90"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>
                        <Label Text="◈"
                               FontSize="36"
                               TextColor="{DynamicResource AuraCyan}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Label Text="Núcleo operacional"
                       FontSize="11"
                       TextColor="{DynamicResource AuraTextMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,-12,0,0" />

                <!-- Card Sistema (glass) -->
                <Border Style="{DynamicResource AuraGlassCardAccent}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚙"
                                   FontSize="16"
                                   TextColor="{DynamicResource AuraAccent}" />
                            <Label Text="SISTEMA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   FontFamily="IBMPlexSans"
                                   TextColor="{DynamicResource AuraAccent}" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{DynamicResource AuraBorder}"
                                 Margin="0,0,0,2" />
                        <Label x:Name="OsLabel"   FontSize="13" TextColor="{DynamicResource AuraTextPrimary}" FontFamily="IBMPlexSans" />
                        <Label x:Name="CpuLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" FontFamily="IBMPlexSans" />
                        <Label x:Name="RamLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" FontFamily="IBMPlexSans" />
                        <Label x:Name="DiskLabel" FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" FontFamily="IBMPlexSans" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Rede (glass) -->
                <Border Style="{DynamicResource AuraGlassCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⊕"
                                   FontSize="16"
                                   TextColor="{DynamicResource AuraCyan}" />
                            <Label Text="REDE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   FontFamily="IBMPlexSans"
                                   TextColor="{DynamicResource AuraCyan}" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{DynamicResource AuraBorder}"
                                 Margin="0,0,0,2" />
                        <Label x:Name="NetLabel" FontSize="13" TextColor="{DynamicResource AuraTextPrimary}" FontFamily="IBMPlexSans" />
                        <Label x:Name="IpLabel"  FontSize="13" TextColor="{DynamicResource AuraTextSecondary}" FontFamily="IBMPlexSans" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Agentes (glass) -->
                <Border Style="{DynamicResource AuraGlassCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="◆"
                                   FontSize="16"
                                   TextColor="{DynamicResource AuraSuccess}" />
                            <Label Text="AGENTES DISPONÍVEIS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   FontFamily="IBMPlexSans"
                                   TextColor="{DynamicResource AuraSuccess}" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{DynamicResource AuraBorder}"
                                 Margin="0,0,0,2" />
                        <Label x:Name="AgentsLabel"
                               FontSize="13"
                               TextColor="{DynamicResource AuraTextSecondary}"
                               FontFamily="IBMPlexSans" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="↻  Atualizar"
                        Clicked="OnRefreshClicked"
                        Style="{DynamicResource BtnGlass}"
                        HorizontalOptions="Start" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Botão flutuante de tema (substitui a bottom bar) ── -->
        <Border Grid.Row="2"
                x:Name="FabTheme"
                BackgroundColor="#2e0d0f18"
                Stroke="{DynamicResource AuraBorderAccent}"
                StrokeThickness="1"
                WidthRequest="60" HeightRequest="60"
                StrokeShape="RoundRectangle 30,30,30,30"
                HorizontalOptions="End"
                Margin="0,0,20,20">
            <Label x:Name="FabIcon"
                   Text="🌙"
                   FontSize="28"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnThemeToggled" />
            </Border.GestureRecognizers>
        </Border>

    </Grid>
</ContentPage>