<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AURA.Mobile.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource AuraBackground}">
    <Grid RowDefinitions="*,Auto" Padding="0">
        <toolkit:MediaElement x:Name="BgVideo"
                              Grid.RowSpan="2"
                              Aspect="AspectFill"
                              ShouldAutoPlay="False"
                              ShouldLoopPlayback="True"
                              ShouldMute="True"
                              Volume="0"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              IsVisible="False" />

        <ScrollView Grid.Row="0" Padding="0" VerticalOptions="Fill">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto" Padding="20,24,20,12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="A U R A" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource AuraAccent}" />
                        <Label x:Name="VersionLabel" FontSize="12" TextColor="{DynamicResource AuraTextSecondary}" />
                    </VerticalStackLayout>
                    <Button x:Name="BtnTheme" Grid.Column="1" Text="☾" FontSize="20" BackgroundColor="Transparent" TextColor="{DynamicResource AuraAccent}" WidthRequest="44" HeightRequest="44" Padding="0" Clicked="OnThemeToggleClicked" />
                </Grid>

                <Border Margin="16,4,16,12" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="12,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="CommandEntry" Grid.Column="0" Placeholder="Pergunte ou diga um comando" PlaceholderColor="{DynamicResource AuraTextMuted}" TextColor="{DynamicResource AuraTextPrimary}" BackgroundColor="Transparent" FontSize="14" ReturnType="Go" Completed="OnCommandCompleted" />
                        <Button x:Name="BtnSendCommand" Grid.Column="1" Text="➤" FontSize="16" BackgroundColor="{DynamicResource AuraAccent}" TextColor="White" WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="10" Clicked="OnSendCommandClicked" />
                    </Grid>
                </Border>

                <Label Text="Ações rápidas" Margin="20,4,20,8" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource AuraTextSecondary}" />
                <Grid Margin="16,0,16,16" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="8,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickDiagnostico" /></Border.GestureRecognizers><VerticalStackLayout Spacing="6"><Label Text="◎" FontSize="22" TextColor="{DynamicResource AuraAccent}" HorizontalTextAlignment="Center" /><Label Text="Diagnosticar" FontSize="10" TextColor="{DynamicResource AuraTextPrimary}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="8,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickProgramas" /></Border.GestureRecognizers><VerticalStackLayout Spacing="6"><Label Text="▷" FontSize="22" TextColor="{DynamicResource AuraAccent}" HorizontalTextAlignment="Center" /><Label Text="Programa" FontSize="10" TextColor="{DynamicResource AuraTextPrimary}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="8,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickTerminal" /></Border.GestureRecognizers><VerticalStackLayout Spacing="6"><Label Text=">_" FontSize="22" TextColor="{DynamicResource AuraAccent}" HorizontalTextAlignment="Center" /><Label Text="Terminal" FontSize="10" TextColor="{DynamicResource AuraTextPrimary}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                    <Border Grid.Column="3" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="8,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickChat" /></Border.GestureRecognizers><VerticalStackLayout Spacing="6"><Label Text="◉" FontSize="22" TextColor="{DynamicResource AuraAccent}" HorizontalTextAlignment="Center" /><Label Text="Perguntar" FontSize="10" TextColor="{DynamicResource AuraTextPrimary}" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                </Grid>

                <Label Text="Estado" Margin="20,4,20,8" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource AuraTextSecondary}" />
                <Border Margin="16,0,16,16" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="14,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Grid ColumnDefinitions="*,*,*"><Label x:Name="StatusSistema" Grid.Column="0" Text="Sistema ✓" FontSize="12" TextColor="{DynamicResource AuraSuccess}" HorizontalTextAlignment="Center" /><Label x:Name="StatusRede" Grid.Column="1" Text="Rede ✓" FontSize="12" TextColor="{DynamicResource AuraSuccess}" HorizontalTextAlignment="Center" /><Label x:Name="StatusBateria" Grid.Column="2" Text="Bateria —" FontSize="12" TextColor="{DynamicResource AuraTextSecondary}" HorizontalTextAlignment="Center" /></Grid></Border>

                <Label Text="Atividade recente" Margin="20,4,20,8" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource AuraTextSecondary}" />
                <Border Margin="16,0,16,8" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="14,12"><Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape><Label x:Name="RecentActivityLabel" Text="Nenhuma atividade recente." FontSize="12" TextColor="{DynamicResource AuraTextMuted}" /></Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource AuraGlassBar}" Margin="12,0,12,12">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <VerticalStackLayout Grid.Column="0"><Button x:Name="BtnInicio" Text="⌂" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraCyan}" HeightRequest="36" Clicked="OnInicioClicked" /><Label Text="Início" FontSize="9" TextColor="{DynamicResource AuraCyan}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"><Button x:Name="BtnDiagnostico" Text="◎" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextPrimary}" HeightRequest="36" Clicked="OnDiagnosticoClicked" /><Label Text="Diagnóstico" FontSize="9" TextColor="{DynamicResource AuraTextSecondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2"><Button x:Name="BtnModulos" Text="⊞" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextPrimary}" HeightRequest="36" Clicked="OnModulosClicked" /><Label Text="Módulos" FontSize="9" TextColor="{DynamicResource AuraTextSecondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3"><Button x:Name="BtnAgentes" Text="◆" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextPrimary}" HeightRequest="36" Clicked="OnAgentesClicked" /><Label Text="Agentes" FontSize="9" TextColor="{DynamicResource AuraTextSecondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4"><Button x:Name="BtnConfig" Text="⚙" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextPrimary}" HeightRequest="36" Clicked="OnConfigClicked" /><Label Text="Config" FontSize="9" TextColor="{DynamicResource AuraTextSecondary}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
