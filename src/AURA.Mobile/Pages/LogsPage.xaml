<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.LogsPage"
             Title="Logs + IA"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12,10,12,16" RowSpacing="10">

        <Label Text="Logs do app + diagnóstico por IA"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="{DynamicResource AuraTextPrimary}" />

        <Label Grid.Row="1"
               Text="Analisar envia o log à IA (OpenRouter). Se não conectar, use Testar conexão para ver o erro exato. Copiar/Compartilhar enviam o log para fora do app."
               FontSize="13"
               TextColor="{DynamicResource AuraTextSecondary}" />

        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource AuraSurface}"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="8">
            <Editor x:Name="LogViewer"
                    TextColor="{DynamicResource AuraTextPrimary}"
                    BackgroundColor="Transparent"
                    FontFamily="monospace"
                    FontSize="11"
                    IsReadOnly="True"
                    AutoSize="TextChanges" />
        </Border>

        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator x:Name="BusyIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{DynamicResource AuraAccent}" />
                <Button x:Name="AnalyzeButton"
                        Text="Analisar com IA"
                        Clicked="OnAnalyzeClicked"
                        Style="{StaticResource BtnPrimary}" />
                <Button x:Name="TestButton"
                        Text="Testar conexão"
                        Clicked="OnTestClicked"
                        Style="{StaticResource BtnGhost}" />
                <Button x:Name="CopyButton"
                        Text="Copiar log"
                        Clicked="OnCopyClicked"
                        Style="{StaticResource BtnGhost}" />
                <Button x:Name="ShareButton"
                        Text="Compartilhar log"
                        Clicked="OnShareClicked"
                        Style="{StaticResource BtnGhost}" />
                <Button x:Name="RefreshButton"
                        Text="Recarregar log"
                        Clicked="OnRefreshClicked"
                        Style="{StaticResource BtnGhost}" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
