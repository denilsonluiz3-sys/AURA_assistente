<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modules="clr-namespace:AURA.Modules;assembly=AURA.Modules"
             x:Class="AURA.Mobile.Pages.ModulesPage"
             Title="Módulos"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">

        <Label Text="Catálogo de módulos (AURA.Modules)"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="{DynamicResource AuraTextPrimary}" />

        <Label x:Name="ConfigSummaryLabel"
               Grid.Row="1"
               FontSize="13"
               TextColor="{DynamicResource AuraTextSecondary}" />

        <CollectionView x:Name="ModulesView" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modules:ModuleInfo">
                    <Frame BackgroundColor="{DynamicResource AuraSurface}"
                           BorderColor="Transparent"
                           CornerRadius="12"
                           Padding="12"
                           Margin="0,4">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DisplayName}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{DynamicResource AuraTextPrimary}" />
                            <Label Text="{Binding ShortDescription}"
                                   FontSize="13"
                                   TextColor="{DynamicResource AuraTextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
