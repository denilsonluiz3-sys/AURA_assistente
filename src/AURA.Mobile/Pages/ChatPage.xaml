<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.ChatPage"
             Title="Assistente"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource AuraSurface}"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                Padding="16,14"
                StrokeShape="RoundRectangle 0,0,0,0">
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="◉"
                           FontSize="14"
                           TextColor="{DynamicResource AuraCyan}" />
                    <Label Text="ASSISTENTE"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AuraCyan}" />
                </HorizontalStackLayout>
                <Label Text="Resposta registrada na memória persistente"
                       FontSize="11"
                       TextColor="{DynamicResource AuraTextMuted}" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Style="{StaticResource AuraCard}" Margin="16,14,16,8">
                <Label x:Name="AnswerLabel"
                       Text="Digite sua pergunta abaixo."
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       TextColor="{DynamicResource AuraTextPrimary}" />
            </Border>

            <CollectionView Grid.Row="1"
                            x:Name="ProcessListView"
                            Margin="12,0,12,10"
                            SelectionMode="None"
                            ItemsLayout="VerticalGrid,2"
                            ItemsSource="{Binding Processes}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="4" HorizontalOptions="Center">
                        <Label Text="Nenhum processo ativo"
                               FontSize="12"
                               TextColor="{DynamicResource AuraTextMuted}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4"
                                Padding="10"
                                BackgroundColor="{DynamicResource AuraSurface}"
                                Stroke="{DynamicResource AuraBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProcessTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{DynamicResource AuraTextPrimary}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="9"
                                           TextColor="{DynamicResource AuraCyan}"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                                <Label Text="{Binding Message}"
                                       FontSize="10"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{DynamicResource AuraTextMuted}" />
                                <ProgressBar Progress="{Binding Progress}"
                                             HeightRequest="3"
                                             ProgressColor="{DynamicResource AuraCyan}"
                                             BackgroundColor="{DynamicResource AuraSurface2}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource AuraSurface}"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                Padding="16,12"
                StrokeShape="RoundRectangle 0,0,0,0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="PROVEDOR"
                               FontSize="10"
                               TextColor="{DynamicResource AuraTextMuted}" />
                        <Picker x:Name="ProviderPicker"
                                Title="Provedor"
                                SelectedIndexChanged="OnProviderChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="MODELO"
                               FontSize="10"
                               TextColor="{DynamicResource AuraTextMuted}" />
                        <Picker x:Name="ModelPicker" Title="Modelo" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="3">
                    <Label x:Name="ApiKeyLabel"
                           Text="CHAVE DE API"
                           FontSize="10"
                           TextColor="{DynamicResource AuraTextMuted}" />
                    <Entry x:Name="ApiKeyEntry"
                           Placeholder="sk-or-… (deixe vazio se não precisar)"
                           IsPassword="True" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border BackgroundColor="{DynamicResource AuraSurface2}"
                            Stroke="{DynamicResource AuraBorder}"
                            StrokeThickness="1"
                            Padding="12,6"
                            StrokeShape="RoundRectangle 12,12,12,12">
                        <Editor x:Name="QuestionEditor"
                                MinimumHeightRequest="40"
                                MaximumHeightRequest="100"
                                Placeholder="Pergunta para a AURA…"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent" />
                    </Border>

                    <Grid Grid.Column="1"
                          WidthRequest="44"
                          HeightRequest="44"
                          VerticalOptions="End">
                        <Button x:Name="SendButton"
                                Text="▶"
                                Clicked="OnSendClicked"
                                BackgroundColor="{DynamicResource AuraCyan}"
                                TextColor="White"
                                CornerRadius="22"
                                FontSize="16"
                                Padding="0"
                                WidthRequest="44"
                                HeightRequest="44" />
                        <ActivityIndicator x:Name="BusyIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="White"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
