<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.ChatPage"
             Title="Assistente"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource AuraSurface}"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                Padding="16,14"
                StrokeShape="RoundRectangle 0,0,0,0">
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="◉"
                           FontSize="14"
                           TextColor="{DynamicResource AuraCyan}" />
                    <Label Text="ASSISTENTE"
                           FontSize="11"
                           LetterSpacing="3"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AuraCyan}" />
                </HorizontalStackLayout>
                <Label Text="Resposta registrada na memória persistente"
                       FontSize="11"
                       TextColor="{DynamicResource AuraTextMuted}" />
            </VerticalStackLayout>
        </Border>

        <!-- ── Área de resposta ───────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14" Spacing="0">
                <Border Style="{StaticResource AuraCard}" Margin="0,0,0,4">
                    <Label x:Name="AnswerLabel"
                           Text="Digite sua pergunta abaixo."
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource AuraTextPrimary}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Painel de configuração + envio ────────────────── -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource AuraSurface}"
                Stroke="{DynamicResource AuraBorder}"
                StrokeThickness="1"
                Padding="16,12"
                StrokeShape="RoundRectangle 0,0,0,0">
            <VerticalStackLayout Spacing="10">

                <!-- Provedor + Modelo lado a lado -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="PROVEDOR"
                               FontSize="10"
                               LetterSpacing="1"
                               TextColor="{DynamicResource AuraTextMuted}" />
                        <Picker x:Name="ProviderPicker"
                                Title="Provedor"
                                SelectedIndexChanged="OnProviderChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="MODELO"
                               FontSize="10"
                               LetterSpacing="1"
                               TextColor="{DynamicResource AuraTextMuted}" />
                        <Picker x:Name="ModelPicker" Title="Modelo" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Chave de API -->
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="ApiKeyLabel"
                           Text="CHAVE DE API"
                           FontSize="10"
                           LetterSpacing="1"
                           TextColor="{DynamicResource AuraTextMuted}" />
                    <Entry x:Name="ApiKeyEntry"
                           Placeholder="sk-or-… (deixe vazio se não precisar)"
                           IsPassword="True" />
                </VerticalStackLayout>

                <!-- Editor de pergunta + envio -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border BackgroundColor="{DynamicResource AuraSurface2}"
                            Stroke="{DynamicResource AuraBorder}"
                            StrokeThickness="1"
                            Padding="12,6"
                            StrokeShape="RoundRectangle 12,12,12,12">
                        <Editor x:Name="QuestionEditor"
                                MinimumHeightRequest="40"
                                MaximumHeightRequest="100"
                                Placeholder="Pergunta para a AURA…"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent" />
                    </Border>

                    <Grid Grid.Column="1"
                          WidthRequest="44"
                          HeightRequest="44"
                          VerticalOptions="End">
                        <Button x:Name="SendButton"
                                Text="▶"
                                Clicked="OnSendClicked"
                                BackgroundColor="{DynamicResource AuraCyan}"
                                TextColor="White"
                                CornerRadius="22"
                                FontSize="16"
                                Padding="0"
                                WidthRequest="44"
                                HeightRequest="44" />
                        <ActivityIndicator x:Name="BusyIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="White"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
