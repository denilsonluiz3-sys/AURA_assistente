<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.ChatPage"
             Title="Assistente"
             BackgroundColor="{StaticResource AuraBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="20" RowSpacing="12">

        <Label Text="Assistente de IA (OpenRouter)"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="{StaticResource AuraTextPrimary}" />

        <Label Grid.Row="1"
               Text="Sua pergunta é respondida pela AURA.AI (mesmo provedor do CLI) e registrada na memória."
               FontSize="13"
               TextColor="{StaticResource AuraTextSecondary}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="AnswerLabel"
                       Text="Digite sua pergunta abaixo."
                       FontSize="14"
                       TextColor="{StaticResource AuraTextPrimary}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Entry x:Name="ApiKeyEntry"
                   Placeholder="Chave OpenRouter (sk-or-...)"
                   IsPassword="True" />
            <Editor x:Name="QuestionEditor"
                    HeightRequest="80"
                    Placeholder="Pergunta para a AURA..."
                    AutoSize="TextChanges" />
            <Button x:Name="SendButton"
                    Text="Enviar"
                    Clicked="OnSendClicked"
                    BackgroundColor="{StaticResource AuraAccent}"
                    TextColor="White"
                    CornerRadius="8" />
            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource AuraAccent}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
