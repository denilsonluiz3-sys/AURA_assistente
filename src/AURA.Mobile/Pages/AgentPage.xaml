<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:AURA.Mobile.Pages"
             x:Class="AURA.Mobile.Pages.AgentPage"
             Title="Agente"
             BackgroundColor="#031426">
    <ContentPage.Resources>
        <Style x:Key="AgentGlassButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#40203952" />
            <Setter Property="TextColor" Value="#D9F5FF" />
            <Setter Property="BorderColor" Value="#5079C9E8" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">
        <Image x:Name="AgentBackground"
               Grid.RowSpan="5"
               Source="agent_background.jpg"
               Aspect="AspectFill"
               Opacity="0.92"
               InputTransparent="True" />
        <Border x:Name="StatusBarHost" Grid.Row="0" Margin="6,5,6,0" BackgroundColor="#55162B43" Stroke="#5079C9E8" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="◆" FontSize="14" TextColor="{DynamicResource AuraAccent}" />
                        <Label Text="AGENTE" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource AuraAccent}" />
                    </HorizontalStackLayout>
                    <Label x:Name="WorkspaceLabel" IsVisible="False" FontSize="9" TextColor="{DynamicResource AuraTextSecondary}" LineBreakMode="TailTruncation" />
                    <Label x:Name="ModelLabel" IsVisible="False" FontSize="9" TextColor="{DynamicResource AuraTextMuted}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="AgentMenuButton" Text="⚡" Clicked="OnAgentMenuClicked" VerticalOptions="Center" Padding="10,6" FontSize="16" BackgroundColor="#30203952" TextColor="#D9F5FF" />
                <Button Grid.Column="2" x:Name="ConfigButton" Text="⚙" Clicked="OnConfigClicked" VerticalOptions="Center" Padding="10,6" FontSize="16" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
                <Button Grid.Column="3" x:Name="ProjectButton" Text="📁" Clicked="OnProjectClicked" SemanticProperties.Description="Abrir informações do projeto" VerticalOptions="Center" Padding="10,6" FontSize="18" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
            </Grid>
        </Border>

        <ScrollView x:Name="ModeChipsHost" IsVisible="False" Grid.Row="1" Margin="8,4,8,0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="42">
            <HorizontalStackLayout Spacing="6" Padding="4,5,4,3">
                <Button x:Name="ModeAgentBtn" Text="Agente" Clicked="OnModeAgentUiClicked" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#128DD4" TextColor="White" CornerRadius="16" />
                <Button x:Name="ModeWebBtn" Text="Web AI" Clicked="OnModeWebUiClicked" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="16" />
                <Button IsVisible="False" Text="📂 Workspace" Clicked="OnChipWorkspace" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button IsVisible="False" Text="🩺 Diagnóstico" Clicked="OnChipDiagnostic" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button IsVisible="False" Text="🧠 Memória" Clicked="OnChipMemory" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="▶ Continuar" Clicked="OnChipContinue" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="🛡 Shell" Clicked="OnChipShellSafe" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
            </HorizontalStackLayout>
        </ScrollView>

        <Border x:Name="ProcessCardsHost" Grid.Row="2" IsVisible="False" BackgroundColor="#55162B43" Stroke="#5079C9E8" StrokeThickness="1" Padding="8,5">
            <CollectionView x:Name="ProcessCards" ItemsSource="{Binding Processes}" ItemsLayout="HorizontalList" HeightRequest="58" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="170" Margin="0,0,8,0" BackgroundColor="#40203952" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <Grid Padding="10,5" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource AuraTextPrimary}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1" Text="{Binding Status}" FontSize="9" TextColor="{DynamicResource AuraAccent}" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Abrir" Clicked="OnProcessCardClicked" FontSize="8" Padding="6,1" HeightRequest="22" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding Progress}" HeightRequest="3" ProgressColor="{DynamicResource AuraAccent}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Grid x:Name="AgentPane" Grid.Row="3" IsVisible="True">
            <ScrollView x:Name="ConversationScroll">
                <VerticalStackLayout x:Name="ConversationContainer" Spacing="8" Padding="16,14,16,20" />
            </ScrollView>
        </Grid>

        <Grid x:Name="WebPane" Grid.Row="3" IsVisible="False" RowDefinitions="Auto,*">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="38">
                <HorizontalStackLayout Spacing="6" Padding="8,4">
                    <Button x:Name="WebBtnDeepSeek" Text="DeepSeek" CommandParameter="deepseek" Clicked="OnWebProviderClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="#128DD4" TextColor="White" CornerRadius="12" />
                    <Button x:Name="WebBtnChatGpt" Text="ChatGPT" CommandParameter="chatgpt" Clicked="OnWebProviderClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                    <Button x:Name="WebBtnClaude" Text="Claude" CommandParameter="claude" Clicked="OnWebProviderClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                    <Button x:Name="WebBtnGemini" Text="Gemini" CommandParameter="gemini" Clicked="OnWebProviderClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                    <Button x:Name="WebBtnPerplexity" Text="Perplexity" CommandParameter="perplexity" Clicked="OnWebProviderClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                    <Button Text="+" Clicked="OnWebMoreClicked" FontSize="14" Padding="12,4" HeightRequest="30" WidthRequest="40" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="12" />
                    <Button Text="↻" Clicked="OnWebReloadClicked" FontSize="12" Padding="8,4" HeightRequest="30" WidthRequest="40" BackgroundColor="#40203952" TextColor="{DynamicResource AuraTextPrimary}" />
                </HorizontalStackLayout>
            </ScrollView>
            <WebView x:Name="BridgeWebView" Grid.Row="1" />
        </Grid>

        <Border x:Name="InputBarHost" Grid.Row="4" Margin="8,4,8,4" ZIndex="50" BackgroundColor="#55162B43" Stroke="#5079C9E8" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="10,6">
            <VerticalStackLayout Spacing="4">
                <ScrollView x:Name="ConfigHost" IsVisible="False" MaximumHeightRequest="260" VerticalScrollBarVisibility="Default" BackgroundColor="#40203952" />
                <Label x:Name="PendingAttachmentLabel" IsVisible="False" FontSize="11" TextColor="{DynamicResource AuraAccent}" LineBreakMode="TailTruncation" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Border Grid.Column="0" BackgroundColor="#40203952" Stroke="#5079C9E8" StrokeThickness="1" Padding="12,5" StrokeShape="RoundRectangle 12,12,12,12">
                        <Editor x:Name="CommandEditor" MinimumHeightRequest="34" MaximumHeightRequest="84" Placeholder="Instrua o agente… (ex.: ls, diagnostique)" AutoSize="TextChanges" BackgroundColor="Transparent" />
                    </Border>
                    <Button Grid.Column="1" x:Name="AttachButton" Text="📎" Clicked="OnAttachmentClicked" SemanticProperties.Description="Importar arquivo para a AURA" FontSize="16" Padding="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="20" VerticalOptions="End" />
                    <Button Grid.Column="2" x:Name="MicrophoneButton" Text="🎙" Clicked="OnMicrophoneClicked" SemanticProperties.Description="Ditado por voz" FontSize="16" Padding="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#40203952" TextColor="{DynamicResource AuraAccent}" CornerRadius="20" VerticalOptions="End" />
                    <Grid Grid.Column="3" WidthRequest="46" HeightRequest="46" VerticalOptions="End" ZIndex="51">
                        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" InputTransparent="True" Color="White" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button x:Name="RunButton" Text="▶" Clicked="OnRunOrStopClicked" BackgroundColor="#128DD4" TextColor="White" CornerRadius="23" FontSize="16" Padding="0" WidthRequest="46" HeightRequest="46" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
