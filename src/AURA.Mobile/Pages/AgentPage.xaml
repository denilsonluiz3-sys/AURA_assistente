<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:AURA.Mobile.Pages"
             x:Class="AURA.Mobile.Pages.AgentPage"
             Title="Agente"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="◆" FontSize="14" TextColor="{DynamicResource AuraAccent}" />
                        <Label Text="AGENTE" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource AuraAccent}" />
                    </HorizontalStackLayout>
                    <Label x:Name="WorkspaceLabel" FontSize="11" TextColor="{DynamicResource AuraTextSecondary}" LineBreakMode="TailTruncation" />
                    <Label x:Name="ModelLabel" FontSize="10" TextColor="{DynamicResource AuraTextMuted}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="AgentMenuButton" Text="⚡" Clicked="OnAgentMenuClicked" VerticalOptions="Center" Padding="10,6" FontSize="16" BackgroundColor="Transparent" TextColor="{DynamicResource AuraAccent}" />
                <Button Grid.Column="2" x:Name="ConfigButton" Text="⚙" Clicked="OnConfigClicked" VerticalOptions="Center" Padding="10,6" FontSize="16" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
                <Button Grid.Column="3" x:Name="ProjectButton" Text="📁 Projeto" Clicked="OnProjectClicked" VerticalOptions="Center" Padding="10,6" FontSize="12" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="42">
            <HorizontalStackLayout Spacing="6" Padding="12,5,12,3">
                <Button x:Name="ModeAgentBtn" Text="Agente" Clicked="OnModeAgentClicked" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraAccent}" TextColor="White" CornerRadius="16" />
                <Button x:Name="ModeWebBtn" Text="Web AI" Clicked="OnModeWebClicked" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="16" />
                <Button Text="📂 Workspace" Clicked="OnChipWorkspace" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="🩺 Diagnóstico" Clicked="OnChipDiagnostic" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="🧠 Memória" Clicked="OnChipMemory" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="▶ Continuar" Clicked="OnChipContinue" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
                <Button Text="🛡 Shell" Clicked="OnChipShellSafe" FontSize="10" Padding="11,5" HeightRequest="32" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraAccent}" CornerRadius="16" />
            </HorizontalStackLayout>
        </ScrollView>

        <Border x:Name="ProcessCardsHost" Grid.Row="2" IsVisible="False" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="8,5">
            <CollectionView x:Name="ProcessCards" ItemsSource="{Binding Processes}" ItemsLayout="HorizontalList" HeightRequest="58" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="170" Margin="0,0,8,0" BackgroundColor="{DynamicResource AuraSurface2}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <Grid Padding="10,5" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource AuraTextPrimary}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1" Text="{Binding Status}" FontSize="9" TextColor="{DynamicResource AuraAccent}" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Abrir" Clicked="OnProcessCardClicked" FontSize="8" Padding="6,1" HeightRequest="22" BackgroundColor="Transparent" TextColor="{DynamicResource AuraTextSecondary}" />
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding Progress}" HeightRequest="3" ProgressColor="{DynamicResource AuraAccent}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Grid x:Name="AgentPane" Grid.Row="3" IsVisible="True">
            <ScrollView x:Name="ConversationScroll">
                <VerticalStackLayout x:Name="ConversationContainer" Spacing="6" Padding="14,12" />
            </ScrollView>
        </Grid>

        <Grid x:Name="WebPane" Grid.Row="3" IsVisible="False" RowDefinitions="Auto,*">
            <HorizontalStackLayout Spacing="6" Padding="8,4">
                <Button Text="DeepSeek" Clicked="OnWebDeepSeekClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                <Button Text="ChatGPT" Clicked="OnWebChatGptClicked" FontSize="11" Padding="10,4" HeightRequest="30" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraTextPrimary}" CornerRadius="12" />
                <Button Text="↻" Clicked="OnWebReloadClicked" FontSize="12" Padding="8,4" HeightRequest="30" WidthRequest="40" BackgroundColor="{DynamicResource AuraSurface2}" TextColor="{DynamicResource AuraTextPrimary}" />
            </HorizontalStackLayout>
            <WebView x:Name="BridgeWebView" Grid.Row="1" />
        </Grid>

        <Border Grid.Row="4" ZIndex="50" BackgroundColor="{DynamicResource AuraSurface}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="12,8">
            <VerticalStackLayout Spacing="6">
                <!-- SetConfigVisible liga IsVisible aqui; altura máxima evita cobrir a tela -->
                <ScrollView x:Name="ConfigHost"
                            IsVisible="False"
                            MaximumHeightRequest="260"
                            VerticalScrollBarVisibility="Default"
                            BackgroundColor="{DynamicResource AuraSurface2}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource AuraSurface2}" Stroke="{DynamicResource AuraBorder}" StrokeThickness="1" Padding="12,5" StrokeShape="RoundRectangle 12,12,12,12">
                        <Editor x:Name="CommandEditor" MinimumHeightRequest="40" MaximumHeightRequest="110" Placeholder="Instrua o agente… (ex.: ls, diagnostique)" AutoSize="TextChanges" BackgroundColor="Transparent" />
                    </Border>
                    <Grid Grid.Column="1" WidthRequest="56" HeightRequest="56" VerticalOptions="End" ZIndex="51">
                        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" InputTransparent="True" Color="White" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button x:Name="RunButton" Text="▶" Clicked="OnRunClicked" BackgroundColor="{DynamicResource AuraAccent}" TextColor="White" CornerRadius="28" FontSize="18" Padding="0" WidthRequest="56" HeightRequest="56" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
