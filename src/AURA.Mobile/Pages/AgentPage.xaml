<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.AgentPage"
             Title="Agente"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">

        <VerticalStackLayout Spacing="2">
            <Label Text="Agente de arquivos"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="{DynamicResource AuraTextPrimary}" />
            <Label x:Name="WorkspaceLabel"
                   FontSize="11"
                   TextColor="{DynamicResource AuraTextSecondary}" />
            <Label x:Name="ModelLabel"
                   FontSize="11"
                   TextColor="{DynamicResource AuraTextSecondary}" />
        </VerticalStackLayout>

        <ScrollView x:Name="ConversationScroll"
                    Grid.Row="1">
            <VerticalStackLayout x:Name="ConversationContainer"
                                 Spacing="8" />
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Editor x:Name="CommandEditor"
                    HeightRequest="76"
                    Placeholder="Ex.: crie um arquivo notas.md com um resumo do projeto, depois liste a pasta"
                    AutoSize="TextChanges" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="RunButton"
                        Text="Executar"
                        Clicked="OnRunClicked"
                        BackgroundColor="{DynamicResource AuraAccent}"
                        TextColor="White"
                        CornerRadius="8" />
                <ActivityIndicator x:Name="BusyIndicator"
                                   Grid.Column="1"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{DynamicResource AuraAccent}"
                                   WidthRequest="28"
                                   HeightRequest="28" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
