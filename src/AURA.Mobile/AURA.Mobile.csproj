<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AURA.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package id fixo: atualização por cima só funciona com a MESMA assinatura. -->
    <ApplicationId>com.aura.genesis</ApplicationId>
    <ApplicationTitle>AURA</ApplicationTitle>
    <!-- versionCode (inteiro): deve subir a cada APK publicado -->
    <ApplicationVersion>22</ApplicationVersion>
    <ApplicationDisplayVersion>2.2</ApplicationDisplayVersion>

    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('Resources\Raw')" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="..\..\modules\packages\**\module.json" LogicalName="modulepkgs/%(RecursiveDir)module.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AURA.Abstractions\AURA.Abstractions.csproj" />
    <ProjectReference Include="..\AURA.Core\AURA.Core.csproj" />
    <ProjectReference Include="..\AURA.Modules\AURA.Modules.csproj" />
    <ProjectReference Include="..\AURA.Agents\AURA.Agents.csproj" />
    <ProjectReference Include="..\AURA.Memory\AURA.Memory.csproj" />
    <ProjectReference Include="..\AURA.AI\AURA.AI.csproj" />
    <ProjectReference Include="..\AURA.Network\AURA.Network.csproj" />
    <ProjectReference Include="..\AURA.SystemInfo\AURA.SystemInfo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#101014" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101014" BaseSize="128,128" />
  </ItemGroup>

</Project>
