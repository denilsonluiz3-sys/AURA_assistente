<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AURA.AI</AssemblyName>
    <RootNamespace>AURA.AI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AURA.Abstractions\AURA.Abstractions.csproj" />
    <ProjectReference Include="..\AURA.Core\AURA.Core.csproj" />
    <ProjectReference Include="..\AURA.Memory\AURA.Memory.csproj" />
  </ItemGroup>

  <!-- Catálogo de provedores/modelos disponível no APK (não só no clone do repo). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\providers.json"
                      Link="config\providers.json"
                      LogicalName="AURA.AI.config.providers.json" />
  </ItemGroup>

</Project>
